# Copy to .env at the repo root (.env is gitignored).
# Required for PR sync on push (see CONTRIBUTING.md).
#
# Create a Harness0 API key (PAT) for the account that owns this repo's origin:
# 1. Sign in at https://harness0.harness.io
# 2. Open your user profile (avatar menu in the top right)
# 3. Under My API Keys, select API Key, enter a name, and select Save
# 4. Under the new key, select Token, enter a name, and select Generate Token
# 5. Copy the token immediately (shown once) and paste it below
# Docs: https://developer.harness.io/docs/platform/automation/api/add-and-manage-api-keys

HARNESS0_API_KEY=

# Optional: Harness account ID for local Harness API tooling (MCP plugin, Harness CLI).
# PR sync does not read this; it derives the account from your git origin URL and matches your PAT to it.
# Find yours under Account Settings in Harness, or in the origin URL (git0.harness.io/<account-id>/...).
HARNESS_ACCOUNT_ID=

# Optional: AI-written PR summary (falls back to git-based summary if unset)
GEMINI_API_KEY=
